<% content_for :title, "Actresses" %>
<header class="page-heading"><div><p class="eyebrow">PEOPLE BEHIND THE TITLES</p><h1>Actresses<span class="heading-dot">.</span></h1><p>A familiar face. A new filmography to explore.</p></div><span class="section-index" aria-hidden="true">INDEX / 02</span></header>
<%= form_tag fanza_actresses_path, method: :get, class: "filter-bar", id: "fuzzySearch", role: "search", aria: { label: "Filter actresses" } do %>
  <div class="filter-field filter-query"><%= label_tag "actress-name", "Actress name" %><%= text_field_tag "fuzzy", params[:fuzzy], id: "actress-name", class: "form-control", placeholder: "Find an actress…" %></div>
  <div class="filter-field"><%= label_tag "actress-order", "Sort by" %><%= select_tag "order", options_for_select([["Newest", "New"], ["Name", "Name"]], @order || "New"), id: "actress-order", class: "form-select" %></div>
  <%= submit_tag "Filter by name", class: "btn btn-success filter-submit" %>
<% end %>
<% if params[:fuzzy].present? %><div class="query-summary"><span>Results for <strong>“<%= params[:fuzzy] %>”</strong></span><%= link_to "Clear search ×", fanza_actresses_path(order: @order) %></div><% end %>
<%= render partial: "layouts/pager", locals: { items: @actresses, name: "actress" } %>
<%= render partial: "fanza_actresses/cards", object: @actresses %>
<% if @actresses.present? %><%= render partial: "layouts/pager", locals: { items: @actresses, name: "actress" } %><% end %>
