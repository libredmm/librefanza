<% visible_actresses = cards.reject(&:is_hidden?) %>
<% if visible_actresses.present? %>
  <div class="actress-grid">
    <% visible_actresses.each do |actress| %>
      <article class="card actress">
        <%= link_to actress.persisted? ? actress : fanza_actress_path(actress.name), class: "actress-link" do %>
          <div class="actress-portrait"><%= image_tag actress.image_url || fake_image_url(actress), alt: actress.name, loading: "lazy", decoding: "async" %></div>
          <div class="card-body"><h3 class="card-title"><%= actress.name %></h3><span class="actress-caption">View filmography <span aria-hidden="true">↗</span></span></div>
        <% end %>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="empty-state"><h2>No actresses to show</h2><p>Try another name or browse the full index.</p><%= link_to "Browse all actresses", fanza_actresses_path, class: "btn btn-outline-primary" %></div>
<% end %>
