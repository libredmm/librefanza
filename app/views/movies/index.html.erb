<% content_for :title, params[:q].present? ? "Movies matching #{params[:q]}" : "Movies" %>
<header class="page-heading">
  <div><p class="eyebrow">THE COLLECTION</p><h1>Movies<span class="heading-dot">.</span></h1><p>Browse the index. Find your next discovery.</p></div>
  <span class="section-index" aria-hidden="true">INDEX / 01</span>
</header>
<%= form_tag movies_path, method: :get, class: "filter-bar", id: "search", role: "search", aria: { label: "Filter movies" } do %>
  <div class="filter-field filter-query"><%= label_tag "filter-q", "Movie ID or prefix" %><%= text_field_tag "q", params[:q], id: "filter-q", class: "form-control", placeholder: "Find a movie…" %></div>
  <div class="filter-field"><%= label_tag "filter-style", "Match" %><%= select_tag "style", options_for_select([["Contains", "fuzzy"], ["Starts with", "prefix"]], @style || :fuzzy), id: "filter-style", class: "form-select" %></div>
  <div class="filter-field"><%= label_tag "filter-order", "Sort by" %><%= select_tag "order", options_for_select((signed_in_as_admin? ? %i[title release_date date_added] : %i[title release_date]).map { |option| [option == :title ? "Movie ID" : option.to_s.titleize, option] }, @order), id: "filter-order", class: "form-select" %></div>
  <%= submit_tag "Search", class: "btn btn-success filter-submit" %>
<% end %>
<% if params[:q].present? %><div class="query-summary"><span>Results for <strong>“<%= params[:q] %>”</strong></span><%= link_to "Clear search ×", movies_path(order: @order) %></div><% end %>
<%= render partial: "movies/cards", object: @movies %>
