<% content_for :title, @item.normalized_id %>
<nav class="breadcrumb-nav" aria-label="Breadcrumb"><%= link_to "Movies", movies_path %><span aria-hidden="true">/</span><span><%= @item.normalized_id %></span></nav>
<header class="movie-heading">
  <div><p class="eyebrow">MOVIE DETAILS</p><h1><%= @item.normalized_id %></h1></div>
  <button class="btn btn-outline-primary copy-button" data-clipboard-text="<%= @item.normalized_id %>" aria-label="Copy movie ID"><span aria-hidden="true">⧉</span> <span data-copy-label>Copy ID</span></button>
</header>
<h2 class="detail-title"><%= @item.title %></h2>
<div class="detail-meta"><span><%= @item.date&.to_date %></span><% if @item.volume.present? %><span><%= @item.volume / 60 %> min</span><% end %><span class="detail-source"><%= @item.class.name.delete_suffix("Item") %></span></div>
<%= render "movies/admin_actions" if signed_in_as_admin? %>
<div class="movie-detail-grid">
  <div class="detail-artwork">
    <div class="cover-frame image-frame" data-image-frame><span class="image-placeholder" aria-hidden="true"><%= @item.normalized_id %><small>Cover unavailable</small></span><%= image_tag @item.cover_image_url, alt: "#{@item.normalized_id} cover", class: "detail-cover", decoding: "async" %></div>
    <%= render "movies/admin_details" if signed_in_as_admin? %>
  </div>
  <aside class="movie-facts" aria-labelledby="details-title">
    <h2 id="details-title">At a glance</h2>
    <dl>
      <dt>Release date</dt><dd><%= @item.date&.to_date || "Unknown" %></dd>
      <% %i[directors genres labels makers].each do |attr| %>
        <% if @item.public_send(attr).present? %><dt><%= attr.to_s.humanize %></dt><dd><div class="metadata-tags"><% @item.public_send(attr).each do |elem| %><span><%= elem %></span><% end %></div></dd><% end %>
      <% end %>
      <% if @item.volume.present? %><dt>Runtime</dt><dd><%= @item.volume / 60 %> minutes</dd><% end %>
      <% if @item.review.present? %><dt>User rating</dt><dd><span class="rating-star" aria-hidden="true">★</span> <%= "%.1f" % @item.review %></dd><% end %>
    </dl>
    <div class="source-links"><p class="eyebrow">EXPLORE THE SOURCES</p><%= link_to @item.url, class: "source-link", rel: "noreferrer" do %><%= image_tag @item.logo_url, alt: @item.class.name.delete_suffix("Item"), referrerpolicy: "no-referrer" %><span aria-hidden="true">↗</span><% end %><%= link_to "https://www.javbus.com/search/#{@item.normalized_id}", class: "source-link", rel: "noreferrer" do %><%= image_tag "javbus.png", alt: "Javbus" %><span aria-hidden="true">↗</span><% end %></div>
  </aside>
</div>
<% if @item.description.present? %><section class="detail-section"><p class="eyebrow">ABOUT THE MOVIE</p><h2>Description</h2><p class="description-text"><%= @item.description %></p></section><% end %>
<% if @item.actresses.present? %><section class="detail-section"><p class="eyebrow">THE PEOPLE</p><h2>Cast</h2><%= render partial: "fanza_actresses/cards", object: @item.actresses %></section><% end %>
<% if @item.sample_image_urls.present? %>
  <section class="detail-section"><div class="section-heading-row"><div><p class="eyebrow">A CLOSER LOOK</p><h2>Sample images</h2></div><span class="section-note">Select an image to view full size ↗</span></div><div id="sample-images"><% @item.sample_image_urls.each_with_index do |img, index| %><%= link_to img, target: "_blank", rel: "noopener noreferrer", class: "sample-image image-frame", data: { image_frame: true } do %><span class="image-placeholder" aria-hidden="true">Image unavailable</span><%= image_tag img, alt: "#{@item.normalized_id} sample #{index + 1} (opens in new tab)", loading: "lazy", decoding: "async" %><% end %><% end %></div></section>
<% end %>
<% if @item.movie.items.count > 1 %><section class="detail-section"><p class="eyebrow">MORE FROM THIS TITLE</p><h2>Other versions</h2><%= render partial: "movies/cards", object: Kaminari.paginate_array(@item.movie.items.excluding(@item)).page(1).per(20), locals: { render_pager: false, link_to_movie: false } %></section><% end %>
<div class="copy-status visually-hidden" role="status" aria-live="polite"></div>
