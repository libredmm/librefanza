<div id="clearance" class="password-reset">
  <h2><%= t(".title") %></h2>

  <p><%= t(".description") %></p>

  <%= form_for :password, url: passwords_path do |form| %>
    <div class="form-group text-field">
      <%= form.label :email %>
      <%= form.email_field :email, class: "form-control", autocomplete: "email" %>
    </div>

    <div class="form-group submit-field">
      <%= form.submit class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
